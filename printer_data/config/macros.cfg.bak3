
[gcode_macro SET_PRINT_STATS_INFO]
variable_pause_next_layer_enable: False
variable_pause_next_layer_call: "PAUSE"
variable_pause_at_layer_enable: False
variable_pause_at_layer_layer: 0
variable_pause_at_layer_call: "PAUSE"
rename_existing: SET_PRINT_STATS_INFO_BASE
description: Overwrite, to get pause_next_layer and pause_at_layer feature
gcode:
  {% if pause_next_layer_enable %}
    {action_respond_info("%s, forced by pause_next_layer" % pause_next_layer_call)}
    {pause_next_layer_call} ; execute the given gcode to pause, should be either M600 or PAUSE
    SET_PAUSE_NEXT_LAYER ENABLE=0
  {% elif pause_at_layer_enable and params.CURRENT_LAYER is defined and params.CURRENT_LAYER|int == pause_at_layer_layer %}
    {action_respond_info("%s, forced by pause_at_layer [%d]" % (pause_at_layer_call, pause_at_layer_layer))}
    {pause_at_layer_call} ; execute the given gcode to pause, should be either M600 or PAUSE
    SET_PAUSE_AT_LAYER ENABLE=0
  {% endif %}
  SET_PRINT_STATS_INFO_BASE {rawparams}
[gcode_macro _TOOLHEAD_PARK_PAUSE_CANCEL]
description: Helper: park toolhead on pause or cancel
gcode:
    {% set x_park = printer.toolhead.axis_maximum.x|float - 5.0 %}
    {% set y_park = printer.toolhead.axis_maximum.y|float - 5.0 %}
    {% set z_park = [printer.toolhead.position.z + 2.0, printer.toolhead.axis_maximum.z]|min %}
    SAVE_GCODE_STATE NAME=park0
    G91
    G1 Z2 F900          ; lift Z a bit to avoid scars
    G90
    G1 X{x_park} Y{y_park} F6000
    RESTORE_GCODE_STATE NAME=park0 MOVE=0[gcode_macro _CLIENT_EXTRUDE]
description: Extrudes, if the extruder is hot enough
gcode:
  {% set macro_found = True if printer['gcode_macro _CLIENT_VARIABLE'] is defined else False %}
  {% set client = printer['gcode_macro _CLIENT_VARIABLE'] %}
  {% set use_fw_retract = False if not macro_found
                     else False if client.use_fw_retract is not defined
                     else True  if client.use_fw_retract|lower == 'true' and printer.firmware_retraction is defined
                     else False %}
  {% set length = (params.LENGTH|float) if params.LENGTH is defined
             else 1.0 if not macro_found
             else client.unretract|default(1.0) %}
  {% set speed = params.SPEED if params.SPEED is defined
            else 35 if not macro_found
            else client.speed_unretract|default(35) %}
  {% set absolute_extrude = printer.gcode_move.absolute_extrude %}
  {% if printer.extruder.can_extrude %}
    {% if use_fw_retract %}
      {% if length < 0 %}
        G10
      {% else %}
        G11
      {% endif %}
    {% else %}
      M83
      G1 E{length} F{(speed|float|abs) * 60}
      {% if absolute_extrude %}
        M82
      {% endif %}
    {% endif %}
  {% else %}
    {action_respond_info("Extruder not hot enough")}
  {% endif %}

[gcode_macro _CLIENT_RETRACT]
description: Retracts, if the extruder is hot enough
gcode:
  {% set macro_found = True if printer['gcode_macro _CLIENT_VARIABLE'] is defined else False %}
  {% set client = printer['gcode_macro _CLIENT_VARIABLE'] %}
  {% set length = (params.LENGTH|float) if params.LENGTH is defined
             else 1.0 if not macro_found
             else client.retract|default(1.0) %}
  {% set speed = params.SPEED if params.SPEED is defined
            else 35 if not macro_found
            else client.speed_retract|default(35) %}
  _CLIENT_EXTRUDE LENGTH=-{length|float|abs} SPEED={speed|float|abs}

[gcode_macro START_PRINT]
gcode:
    RESET_LAYER_PAUSES
  G92 E0 ; Reset Extruder
  G28 ; Home all axes
  {% set BED_TEMP = params.BED_TEMP|default(70)|float %}
  {% set EXTRUDER_TEMP = params.EXTRUDER_TEMP|default(190)|float %}
  M140 S{BED_TEMP}
  M104 S150
  M190 S{BED_TEMP}
  BED_MESH_CALIBRATE
  M104 S{EXTRUDER_TEMP}
  G1 Z2.0 F3000 ; Move Z Axis up little to prevent scratching of Heat Bed
  G1 X0.1 Y20 Z0.3 F5000.0 ; Move to start position
  M109 S{EXTRUDER_TEMP} ;Wait for extruder to reach temp before proceeding
  G1 X0.1 Y200.0 Z0.3 F1500.0 E15 ; Draw the first line
  G1 X0.4 Y200.0 Z0.3 F5000.0 ; Move to side a little
  G1 X0.4 Y20 Z0.3 F1500.0 E30 ; Draw the second line
  G92 E0 ; Reset Extruder
  G1 Z2.0 F3000 ; Move Z Axis up little to prevent scratching of Heat Bed
  G1 X5 Y20 Z0.3 F5000.0 ; Move over to prevent blob squish

[gcode_macro END_PRINT]
gcode:
    M140 S0
    M104 S0
    M106 S0
    G91
    G1 X-2 Y-2 E-3 F300
    G1 Z20 F3000
    G90
    G1 Y230 F3000
    M84

[gcode_macro FILAMENT_CHANGE]
description: Pause print, park nozzle and prepare for filament change
gcode:
  PAUSE
  M117 Changing Filament...
  G91
  G1 Z10 F1000
  G90
  G1 X10 Y220 F10000
  M104 S0
  M140 S0
  M106 S0

[gcode_macro FILAMENT_CHANGE_LOAD]
description: Resume after filament change
gcode:
  M117 Resuming print...
  M104 S{params.EXTRUDER_TEMP|default(200)}
  M140 S{params.BED_TEMP|default(60)}
  M109 S{params.EXTRUDER_TEMP|default(200)}
  M190 S{params.BED_TEMP|default(60)}
  RESUME

[gcode_macro BABYSTEP_Z_UP]
gcode:
  M290 Z0.05

[gcode_macro BABYSTEP_Z_DOWN]
gcode:
  M290 Z-0.05

[gcode_macro PRESSURE_ADVANCE_TUNE_START]
description: Prepare printer for pressure advance tuning moves
gcode:
  M117 Pressure Advance Tuning Start
  SET_PRESSURE_ADVANCE ADVANCE=0
  G28
  G1 Z5 F6000

[gcode_macro PRESSURE_ADVANCE_TUNE_SET]
description: Set pressure advance during tuning
gcode:
  {% if 'ADVANCE' in params %}
    SET_PRESSURE_ADVANCE ADVANCE={params.ADVANCE}
    M117 Pressure Advance set to {params.ADVANCE}
  {% else %}
    M117 Please provide ADVANCE parameter
  {% endif %}

[gcode_macro PRESSURE_ADVANCE_TUNE_END]
description: End pressure advance tuning
gcode:
  M117 Pressure Advance Tuning Complete



[gcode_macro SET_PAUSE_NEXT_LAYER]
description: Enable/disable pause on next layer
gcode:
    {% set enable = params.ENABLE|default(0)|int %}
    SET_GCODE_VARIABLE MACRO=SET_PRINT_STATS_INFO VARIABLE=pause_next_layer_enable VALUE={enable}
    RESPOND TYPE=notice MSG="pause_next_layer set to {enable}"

[gcode_macro SET_PAUSE_AT_LAYER]
description: Enable/disable pause at a specific layer
gcode:
    {% set enable = params.ENABLE|default(0)|int %}
    {% set layer  = params.LAYER|default(0)|int %}
    SET_GCODE_VARIABLE MACRO=SET_PRINT_STATS_INFO VARIABLE=pause_at_layer_enable VALUE={{ enable }}
    SET_GCODE_VARIABLE MACRO=SET_PRINT_STATS_INFO VARIABLE=pause_at_layer_layer  VALUE={{ layer }}
    RESPOND TYPE=notice MSG="pause_at_layer set to {{ enable }} at layer {{ layer }}"

[gcode_macro RESET_LAYER_PAUSES]
description: Hard-disable any layer pause toggles
gcode:
    SET_GCODE_VARIABLE MACRO=SET_PRINT_STATS_INFO VARIABLE=pause_next_layer_enable VALUE=0
    SET_GCODE_VARIABLE MACRO=SET_PRINT_STATS_INFO VARIABLE=pause_at_layer_enable  VALUE=0
    SET_GCODE_VARIABLE MACRO=SET_PRINT_STATS_INFO VARIABLE=pause_at_layer_layer   VALUE=0
[gcode_macro PAUSE]
rename_existing: PAUSE_BASE
description: Pause and park safely
gcode:
    PAUSE_BASE
    _TOOLHEAD_PARK_PAUSE_CANCEL


[gcode_macro RESUME]
rename_existing: RESUME_BASE
description: Re-prime and continue where it left off
gcode:
    G91
    G1 E1.0 F900        ; small re-prime (tune if needed)
    G90
    M106 S{(printer.fan.speed * 255)|int}
    RESUME_BASE
